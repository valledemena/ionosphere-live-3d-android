{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/valledemena/ionosphere-live-3d-android/docs/contracts/aurora.schema.json",
  "title": "AuroraData (mirror of web AuroraData)",
  "type": "object",
  "required": ["updated", "observationTime", "forecastTime", "cells", "source"],
  "additionalProperties": false,
  "properties": {
    "updated": { "type": "integer" },
    "observationTime": { "type": "string" },
    "forecastTime": { "type": "string" },
    "source": { "type": "string" },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lat", "lon", "p"],
        "additionalProperties": false,
        "properties": {
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "p": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
